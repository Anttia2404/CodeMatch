# Host-run backend development only. Root .env is used by Docker Compose.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/codematch
SPRING_DATASOURCE_USERNAME=codematch
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD
CODEMATCH_CV_STORAGE_DIR=C:/Users/replace-me/.codematch/private-cvs
CODEMATCH_CORS_ALLOWED_ORIGIN=http://localhost:5173
CODEMATCH_COOKIE_SECURE=false
