# Local Vite proxy forwards same-origin requests to this backend URL.
VITE_API_BASE_URL=/api/v1
CODEMATCH_API_PROXY_TARGET=http://127.0.0.1:8080
POSTGRES_DB=codematch
POSTGRES_USER=codematch
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEV_PASSWORD
CODEMATCH_CORS_ALLOWED_ORIGIN=http://localhost:5173
CODEMATCH_COOKIE_SECURE=false
CODEMATCH_CV_STORAGE_DIR=C:/Users/replace-me/.codematch/private-cvs
