{$CODEMATCH_DOMAIN} {
	encode zstd gzip
	root * /srv

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; upgrade-insecure-requests"
		-Server
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8080
	}

	@health path /actuator/health /actuator/health/*
	handle @health {
		reverse_proxy api:8080
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
